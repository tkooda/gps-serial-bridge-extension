{
  "manifest_version": 3,
  "name": "GPS Serial Bridge",
  "version": "1.0",
  "description": "Bridges local hardware serial NMEA data streams directly into the browser Geolocation API.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  }
}
